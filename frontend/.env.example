# Base URL for SnapLink Backend API
# Example: http://localhost:5000 or https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:5000

# Base URL for the analytics-service (click stats). Same idea as above —
# leave empty during local dev if you're proxying, or point it at the
# deployed Render URL in production.
VITE_ANALYTICS_API_URL=http://localhost:4000
